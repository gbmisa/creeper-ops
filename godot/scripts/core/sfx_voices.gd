## Thick slow fluid: a low rumble plus random gloops.
static func _bubbles(sec: float) -> Array:
	var parts: Array = [["noise", 0.0, sec + 0.3, 260, 0, 0.3, {"env": "flat", "trem": [0.4, 0.5]}]]
	var rng := RandomNumberGenerator.new()
	rng.seed = 7
	for i in int(sec * 7.0):
		var f := rng.randf_range(160.0, 420.0)
		parts.append(["sin", rng.randf_range(0.0, sec), rng.randf_range(0.05, 0.12), f, f * 1.9,
			rng.randf_range(0.05, 0.14), {"a": 0.01}])
	return parts
